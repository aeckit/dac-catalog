  "metadata": {
    "id": "floor-joist-detail",
    "title": "Platform Framing Floor Joist Assembly",
    "description": "Complete platform-framed floor joist bearing detail over 2x6 exterior wall top plates with rim board, subflooring, and sole plate.",
    "category": "Framing",
    "tags": ["framing", "floor-joist", "rim-joist", "platform-framing", "2x6", "subfloor", "residential"],
    "notes": [
      "3/4\" T&G OSB or plywood subfloor glued and nailed to joists.",
      "Solid blocking or rim board required at all joist bearing ends.",
      "Fasten top plates with 16d common nails @ 16\" o.c. staggered."
    ]
  },
