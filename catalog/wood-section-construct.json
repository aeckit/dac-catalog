{
  "type": "CAD::Construct",
  "version": "1.0",
  "metadata": {
    "id": "wood-section-construct",
    "title": "Nominal Lumber Cross Section",
    "description": "Parametric 2x nominal lumber cross-section with standardized dimensional variable mapping and timber cross hatch.",
    "category": "Framing",
    "tags": ["timber", "lumber", "framing", "construct", "2x4", "2x6", "2x8"],
    "notes": [
      "Surfaced four sides (S4S) standard dimensional lumber.",
      "TimberCross hatch indicates cross-grain cut in elevation/section."
    ]
  },
  "parameters": {
    "lumberSize": {
      "type": "string",
      "default": "2x4",
      "value": "2x4",
      "label": "Lumber Size",
      "options": [
        {
          "label": "2x4 (1-1/2\" x 3-1/2\")",
          "value": "2x4",
          "variables": {
            "width": 3.5,
            "height": 1.5
          }
        },
        {
          "label": "2x6 (1-1/2\" x 5-1/2\")",
          "value": "2x6",
          "variables": {
            "width": 5.5,
            "height": 1.5
          }
        },
        {
          "label": "2x8 (1-1/2\" x 7-1/4\")",
          "value": "2x8",
          "variables": {
            "width": 7.25,
            "height": 1.5
          }
        }
      ]
    }
  },
  "geometry": [
    {
      "componentId": "lumber_body",
      "type": "CAD::Shape::Rectangle",
      "x": 0,
      "y": 0,
      "width": "{parameters.lumberSize.width}",
      "height": "{parameters.lumberSize.height}",
      "color": "#d97706",
      "fill": "rgba(217, 119, 6, 0.15)",
      "hatch": "TimberCross",
      "strokeWidth": 1.5
    },
    {
      "componentId": "lumber_label",
      "type": "CAD::Annotation::Text",
      "x": "{parameters.lumberSize.width} / 2",
      "y": "{parameters.lumberSize.height} / 2",
      "text": "{parameters.lumberSize}",
      "fontSize": 12,
      "color": "#d97706"
    }
  ]
}
